# Is file ko copy karke ".env" naam se save karein aur values bharen. ".env" ko KABHI GitHub par na daalen.
PORT=4000

# ---- MongoDB Atlas (zaroori) ----
# Atlas > Connect > Drivers se connection string lein. <password> ki jagah database user ka password (special characters URL-encode karein).
# "/maison-blush" database ka naam hai.
MONGODB_URI=mongodb+srv://<dbuser>:<password>@<cluster>.mongodb.net/maison-blush?retryWrites=true&w=majority

# Agar frontend alag domain par host ho to uska address (admin panel ke liye same domain behtar hai — README dekhein)
CORS_ORIGIN=

# demo = card payment sirf dikhawa (asli paisa nahi katta). live = gateway jorne ke baad
PAYMENT_MODE=demo

# ---- Payment gateways (sirf jab merchant account mil jaye) ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# OPTIONAL: Claude se smart chatbot (khali ho to rule-based chatbot chalta hai)
ANTHROPIC_API_KEY=

# OPTIONAL: apne website ka poora address (link-preview ke liye). Khali chorden to server khud pehchan leta hai.
SITE_URL=
